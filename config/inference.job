#!/bin/bash
#SBATCH --job-name=wsb_inference
#SBATCH --time=08:00:00
#SBATCH --account=tra26_bbs
#SBATCH --partition=boost_usr_prod
#SBATCH --qos=normal
#SBATCH --nodes=1
#SBATCH --tasks-per-node=1
#SBATCH --cpus-per-task=16
#SBATCH --error=wsb_inference-%j.err
#SBATCH --output=wsb_inference-%j.out

# Inference job — runs run_inference.py on a compute node.
# The LLM server (vLLM) must already be running via LLM_start.job.
# SSH-independent: keeps running if you disconnect.
#
# Usage:
#   sbatch config/inference.job                                        # wsb_2026.csv, fresh
#   sbatch --export=ALL,RESUME=1 config/inference.job                  # wsb_2026.csv, resume
#   sbatch --export=ALL,INPUT=data/jun.csv config/inference.job        # custom file, fresh
#   sbatch --export=ALL,INPUT=data/may.csv,RESUME=1 config/inference.job  # custom file, resume
#
# Run multiple datasets in parallel:
#   sbatch --export=ALL,INPUT=data/wsb_jun.csv config/inference.job
#   sbatch --export=ALL,INPUT=data/wsb_may.csv config/inference.job
#   sbatch --export=ALL,INPUT=data/wsb_apr.csv config/inference.job
#
# Monitor:
#   squeue --me
#   tail -f wsb_inference-<JOBID>.out
#   wc -l output/<stem>_checkpoint.csv

INPUT_FILE="${INPUT:-data/wsb_2026.csv}"
RESUME_FLAG=""

if [ "${RESUME:-0}" = "1" ]; then
    RESUME_FLAG="--resume"
    echo "[INFO] Mode: resume from checkpoint"
else
    echo "[INFO] Mode: fresh run"
fi

echo "[INFO] Job started:  $(date)"
echo "[INFO] Node:         $(hostname)"
echo "[INFO] Input file:   $INPUT_FILE"

source .venv/bin/activate

# Wait for vLLM to be ready before starting inference
echo "[INFO] Waiting for LLM endpoint to appear..."
VLLM_IP=""
for i in $(seq 1 90); do
    VLLM_IP=$(grep -h "Starting head node" llm_launcher_small-*.out 2>/dev/null | tail -1 | grep -oP '(?<=at )\d+\.\d+\.\d+\.\d+' || true)
    if [ -n "$VLLM_IP" ]; then
        echo "[INFO] Found LLM node at $VLLM_IP, waiting for /health..."
        for j in $(seq 1 40); do
            STATUS=$(curl -s -o /dev/null -w "%{http_code}" "http://$VLLM_IP:8000/health" 2>/dev/null || echo "000")
            if [ "$STATUS" = "200" ]; then
                echo "[INFO] vLLM ready at http://$VLLM_IP:8000 after ~$((j)) min"
                break 2
            fi
            echo "[INFO] vLLM not ready yet (HTTP $STATUS), attempt $j/40, sleeping 60s..."
            sleep 60
        done
    fi
    echo "[INFO] No LLM output file yet, attempt $i/90, sleeping 60s..."
    sleep 60
done

if [ -z "$VLLM_IP" ]; then
    echo "[ERROR] vLLM never became ready after 90 min, aborting."
    exit 1
fi

python run_inference.py --input "$INPUT_FILE" $RESUME_FLAG

EXIT_CODE=$?
echo "[INFO] Job finished: $(date) (exit code $EXIT_CODE)"
exit $EXIT_CODE

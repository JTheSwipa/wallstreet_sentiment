#!/bin/bash
#SBATCH --job-name=wsb_inference
#SBATCH --time=06:00:00
#SBATCH --account=tra26_bbs
#SBATCH --partition=lrd_all_serial
#SBATCH --nodes=1
#SBATCH --tasks-per-node=1
#SBATCH --cpus-per-task=4
#SBATCH --error=wsb_inference-%j.err
#SBATCH --output=wsb_inference-%j.out

# Inference job — runs run_inference.py on a CPU node.
# The LLM server (vLLM) must already be running via LLM_start.job.
# This job is SSH-independent: it keeps running if you disconnect.
#
# Usage:
#   sbatch config/inference.job                          # full run
#   sbatch config/inference.job --export=RESUME=1        # resume from checkpoint
#
# Monitor progress:
#   tail -f wsb_inference-<JOBID>.out

INPUT_FILE="data/wsb_2026.csv"
RESUME_FLAG=""

# Pass RESUME=1 via --export to resume from checkpoint
if [ "${RESUME:-0}" = "1" ]; then
    RESUME_FLAG="--resume"
    echo "[INFO] Resuming from checkpoint"
else
    echo "[INFO] Starting fresh run"
fi

echo "[INFO] Job started: $(date)"
echo "[INFO] Node: $(hostname)"
echo "[INFO] Input: $INPUT_FILE"

source .venv/bin/activate

python run_inference.py --input "$INPUT_FILE" $RESUME_FLAG

echo "[INFO] Job finished: $(date)"
